{
 "id": "software",
 "name": "Software team",
 "description": "A product board with bugs, features and chores, story points, a priority and a component.",
 "board": {
  "prefix": "APP",
  "groupLabel": "Area",
  "columns": [
   {
    "name": "Backlog",
    "limit": null
   },
   {
    "name": "Ready",
    "limit": null
   },
   {
    "name": "In progress",
    "limit": 3
   },
   {
    "name": "Review",
    "limit": 3
   },
   {
    "name": "Done",
    "limit": null,
    "done": true
   }
  ],
  "labels": [
   {
    "name": "Bug",
    "color": "rose"
   },
   {
    "name": "Feature",
    "color": "blue"
   },
   {
    "name": "Chore",
    "color": "slate"
   }
  ],
  "properties": [
   {
    "name": "Points",
    "type": "number",
    "min": 0,
    "max": 100,
    "decimals": 0,
    "unit": "pts"
   },
   {
    "name": "Priority",
    "type": "choice",
    "choices": [
     {
      "name": "Low",
      "color": "slate"
     },
     {
      "name": "Medium",
      "color": "blue"
     },
     {
      "name": "High",
      "color": "amber"
     },
     {
      "name": "Urgent",
      "color": "rose"
     }
    ]
   },
   {
    "name": "Component",
    "type": "choice",
    "choices": [
     {
      "name": "Web app",
      "color": "teal"
     },
     {
      "name": "API",
      "color": "violet"
     },
     {
      "name": "Docs",
      "color": "green"
     }
    ]
   }
  ],
  "views": [
   {
    "name": "Open bugs",
    "query": "label:bug -column:done",
    "sort": "-priority"
   },
   {
    "name": "Urgent",
    "query": "priority:urgent -column:done",
    "sort": ""
   },
   {
    "name": "Big items",
    "query": "points:>=8 -column:done",
    "sort": "-points"
   }
  ],
  "settings": {
   "cardFace": [
    "labels",
    "Priority",
    "Points",
    "progress",
    "blocked"
   ],
   "limitPolicy": "warn",
   "defaultView": null
  },
  "template": [
   "What and why",
   "Done when"
  ],
  "checklists": [
   {
    "id": "definition-of-done",
    "name": "Definition of done",
    "items": [
     {
      "id": "i-tests",
      "text": "Tests cover the change",
      "heading": false
     },
     {
      "id": "i-review",
      "text": "Someone else has reviewed it",
      "heading": false
     },
     {
      "id": "i-docs",
      "text": "Docs are updated",
      "heading": false
     }
    ]
   }
  ]
 },
 "cards": [
  {
